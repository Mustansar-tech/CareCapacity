# ─── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# ─── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Session ───────────────────────────────────────────────────────────────────
# Any random string ≥ 32 characters — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Admin seed user ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe123!

# ─── CORS (required when frontend is on a different domain e.g. Vercel) ────────
# Set this to your Vercel deployment URL. Omit entirely for same-origin deploys.
CORS_ORIGIN=https://your-app.vercel.app

# ─── Routing APIs ──────────────────────────────────────────────────────────────
ORS_API_KEY=your-openrouteservice-api-key
TRAVELTIME_APP_ID=your-traveltime-app-id
TRAVELTIME_API_KEY=your-traveltime-api-key

# ─── People Planner automation (optional) ──────────────────────────────────────
# Slot 0 — fallback account with access to all branches
ACCESS_EMAIL=admin@youraccess.com
ACCESS_PASSWORD=your-access-password

# Additional account slots (optional — see replit.md for branch→slot mapping)
# ACCESS_EMAIL_1=slot1@youraccess.com
# ACCESS_PASSWORD_1=password1
# ACCESS_EMAIL_2=slot2@youraccess.com
# ACCESS_PASSWORD_2=password2

# JSON map of branchId to { workspaceBranch, plannerArea }
PEOPLE_PLANNER_BRANCH_CONFIG={}

# ─── Frontend env var (set in Vercel dashboard, NOT here) ──────────────────────
# VITE_API_BASE_URL=https://your-hetzner-or-do-server.com
